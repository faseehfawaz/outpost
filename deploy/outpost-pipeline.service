# DEPRECATED — do not enable.
#
# This unit ran `pkintel run all --loop`: every stage sequentially in one
# process, so a slow stage blocked every stage behind it and the box used one
# CPU thread out of twelve. It is superseded by the per-stage outpost@*.service
# units, started as a group via outpost.target.
#
#   systemctl disable --now outpost-pipeline.service
#   systemctl enable  --now outpost.target
#
# It is kept only so an existing deployment that still has it enabled gets a
# clear failure and a pointer, rather than silently running every stage twice
# alongside the outpost@* units. Conflicts= makes that double-run impossible.

[Unit]
Description=Outpost pipeline (DEPRECATED — use outpost.target)
Documentation=https://github.com/faseehfawaz/outpost
Conflicts=outpost.target
RefuseManualStart=true

[Service]
Type=oneshot
ExecStart=/usr/bin/false
