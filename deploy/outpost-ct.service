# DEPRECATED — do not enable.
#
# Despite the name this unit ran the *ingest* stage (`pkintel run ingest`), not
# Certificate Transparency. The result was that a deployment following the old
# setup instructions ran ingest twice: once here and once inside
# outpost-pipeline.service.
#
# The real CT consumer is outpost-certstream.service (the firehose), and the
# ingest stage is outpost@ingest.service. Both start with outpost.target.
#
#   systemctl disable --now outpost-ct.service
#   systemctl enable  --now outpost.target

[Unit]
Description=Outpost CT listener (DEPRECATED — use outpost-certstream.service)
Documentation=https://github.com/faseehfawaz/outpost
Conflicts=outpost.target
RefuseManualStart=true

[Service]
Type=oneshot
ExecStart=/usr/bin/false
