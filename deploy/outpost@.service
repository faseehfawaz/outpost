# Templated per-stage worker unit.
#
# Replaces outpost-pipeline.service, which ran `pkintel run all --loop` — every
# stage SEQUENTIALLY in one process, so a slow stage blocked every stage behind
# it and the box used one CPU thread out of twelve.
#
# Each stage is now its own service, scheduled independently by the kernel.
# Start them as a group:
#
#   systemctl enable --now outpost.target
#
# or individually:
#
#   systemctl restart outpost@triage
#
# Per-stage interval, batch size and resource limits come from the environment
# and from drop-ins (see below), so a stage can be tuned without touching any
# other.

[Unit]
Description=Outpost pipeline stage: %i
Documentation=https://github.com/faseehfawaz/outpost
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
PartOf=outpost.target
# Never run alongside the legacy all-in-one unit: it runs these same stages, so
# both together means every stage executes twice and every victim server sees
# double the requests.
Conflicts=outpost-pipeline.service outpost-ct.service

# NOTE: StartLimit* belong in [Unit], not [Service]. They lived in [Service]
# for a while, where systemd logs "Unknown key name" and silently applies NO
# rate limiting — the exact crash-loop protection the comment claimed. Verify
# any edit with:  systemd-analyze verify /etc/systemd/system/outpost@.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=outpost
Group=outpost
WorkingDirectory=/opt/heapleap
EnvironmentFile=/opt/heapleap/.env
# Per-stage overrides, e.g. /opt/heapleap/.env.triage can set
# PKINTEL_TRIAGE_WORKERS=96. Missing files are ignored (leading '-').
EnvironmentFile=-/opt/heapleap/.env.%i
Environment=OUTPOST_STAGE=%i
Environment=OUTPOST_INTERVAL=30
# Per-stage Prometheus listener. Without this every counter a worker increments
# (stage_duration, urls_processed, deep_rescued, rows_reaped, ...) is written
# into an in-process registry that nothing scrapes and that dies with the
# process. Overridden per stage by the drop-ins in deploy/stage-env/.
Environment=OUTPOST_METRICS_PORT=0

ExecStart=/opt/heapleap/venv/bin/pkintel run %i --loop --interval ${OUTPOST_INTERVAL}

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=outpost-%i

# --- resource limits (12 threads / 32 GB box) ---------------------------------
# 64+ concurrent sockets per stage plus Chromium needs far more than the default.
LimitNOFILE=262144
# Default ceiling. 10 stages x 8G was an 80 GB budget on a 32 GB box; the real
# per-stage figures are set in deploy/stage-env/<stage>.conf drop-ins, which
# total ~21 GB and leave room for Postgres (8 GB shared_buffers) and the page
# cache. This value only applies to a stage with no drop-in.
MemoryMax=2G
MemoryHigh=1500M
# Nice the bulk stages so interactive API latency never suffers.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

# --- hardening ----------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Leading '-' makes a path optional. Without it, a missing directory makes
# systemd fail to set up the mount namespace and the unit REFUSES TO START —
# /opt/heapleap/logs is never created by setup-elitedesk.sh, so every stage
# unit failed at boot. .cache is needed because ProtectSystem=strict makes
# /opt/heapleap read-only and Playwright writes its browser cache there.
ReadWritePaths=/opt/heapleap/.storage -/opt/heapleap/logs -/opt/heapleap/.cache /dev/shm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
